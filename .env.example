# ===== LLM / external APIs =====
OPENAI_API_KEY=sk-...

# Optional: Cohere reranker (falls back to local BGE if empty)
COHERE_API_KEY=
# Web search tool
TAVILY_API_KEY=
# Notion connector
NOTION_TOKEN=

# ollama, i am running it in docker u can also have it in another machine and handle the scalling...
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_NUM_PARALLEL=4

# ===== Concurrency & Pool Sizing =====
LLM_API_CONCURRENCY=50
LLM_LOCAL_CONCURRENCY=4
LLM_TIMEOUT=60
LLM_LOCAL_TIMEOUT=120
LLM_MAX_RETRIES=3
CHECKPOINTER_POOL_SIZE=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
UVICORN_WORKERS=3
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_ACTIONS=10/minute
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# ===== Jira =====
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP

# ===== Security =====
# Generate: openssl rand -hex 32
JWT_SECRET=
# you use python to generate  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ===== Langfuse (self-hosted LLM tracing) =====
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_HOST=http://localhost:3000
# Traces hold customer prompts/completions. Purged daily past this age. 0 disables (not recommended).
LANGFUSE_TRACE_RETENTION_DAYS=30
# Generate: openssl rand -base64 32
LANGFUSE_SALT=
# Generate: openssl rand -hex 32   (must be exactly 64 hex chars / 32 bytes)
LANGFUSE_ENCRYPTION_KEY=
# Generate: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
# Generate: openssl rand -base64 24
LANGFUSE_INIT_USER_PASSWORD=

# ===== Grafana (metrics + logs dashboards) =====
GRAFANA_ADMIN_USER=admin
# Generate: openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=

# ===== Infra =====
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app
# Owner role for migrations & RLS management (runtime app uses the app_rls role)
DATABASE_URL_MIGRATIONS=postgresql+asyncpg://app:app@localhost:5433/app
QDRANT_URL=http://localhost:6333

# ===== Tenancy =====
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
REDIS_URL=redis://localhost:6379/0
