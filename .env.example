# ===== LLM / external APIs =====
OPENAI_API_KEY=sk-...

# Optional: Cohere reranker (falls back to local BGE if empty)
COHERE_API_KEY=
# Web search tool
TAVILY_API_KEY=
# Notion connector
NOTION_TOKEN=

# ollama, i am running it in docker u can also have it in another machine...
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_NUM_PARALLEL=4

# ===== Concurrency & Pool Sizing =====
LLM_API_CONCURRENCY=50
LLM_LOCAL_CONCURRENCY=4
LLM_TIMEOUT=60
LLM_LOCAL_TIMEOUT=120
LLM_MAX_RETRIES=3
CHECKPOINTER_POOL_SIZE=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
UVICORN_WORKERS=3
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_ACTIONS=10/minute
RATE_LIMIT_STORAGE_URL=redis://localhost:6379/1

# ===== Jira =====
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SUP

# ===== Security =====
JWT_SECRET=change-me-to-a-long-random-string
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# ===== Infra =====
# Note: compose maps postgres to host port 5433 (5432 often taken by a local install)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app
QDRANT_URL=http://localhost:6333
REDIS_URL=redis://localhost:6379/0
